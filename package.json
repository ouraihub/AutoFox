{
  "name": "autofox",
  "version": "0.1.0",
  "private": true,
  "description": "AutoFox desktop media downloader",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.6.0",
  "engines": { "node": "24.21.0", "pnpm": "12.6.0" },
  "scripts": {
    "check:node": "node scripts/check-node.mjs",
    "preinstall": "node scripts/check-node.mjs",
    "dev": "node scripts/check-node.mjs && vite dev",
    "build": "node scripts/check-node.mjs && vite build",
    "preview": "node scripts/check-node.mjs && vite preview",
    "check": "node scripts/check-node.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && pnpm run lint:css",
    "lint:css": "stylelint \"src/**/*.{css,svelte}\"",
    "test:rust": "scripts\\cargo-msvc.bat test --workspace --locked",
    "clippy": "scripts\\cargo-msvc.bat clippy --workspace --all-targets --locked -- -D warnings",
    "fmt:rust": "scripts\\cargo-msvc.bat fmt --all -- --check",
    "dev:app": "node scripts/check-node.mjs && scripts\\dev.bat",
    "build:app": "node scripts/check-node.mjs && scripts\\build-app.bat",
    "generate:notice": "node scripts/generate-notice.mjs",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "tauri": "tauri",
    "verify": "pnpm run check && pnpm run lint && pnpm run test:rust && pnpm run clippy && pnpm run fmt:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-opener": "2.5.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lucide/svelte": "1.31.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "24.10.1",
    "bits-ui": "2.19.3",
    "clsx": "2.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.22.0",
    "globals": "17.9.0",
    "postcss-html": "2.0.0",
    "shadcn-svelte": "1.7.0",
    "stylelint": "17.14.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.3.1"
  }
}
